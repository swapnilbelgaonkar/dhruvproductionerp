# Copy to deploy/.env on the server. Never commit the filled-in file.
APP_VERSION=replace-with-image-tag
ERP_DOMAIN=erp.example.in
DB_PASSWORD=replace-with-a-long-random-password
# 32 random bytes, base64: openssl rand -base64 32 — keep a sealed copy offline; without it encrypted bank numbers and authenticator secrets cannot be read
APP_ENCRYPTION_KEY=
# first administrator (must change the password at first sign-in)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
# read by the live message adapters through the names set in Administration → Integrations (userEnv, passwordEnv, tokenEnv)
SMTP_USER=
SMTP_PASSWORD=
SMS_TOKEN=
WHATSAPP_TOKEN=
# backups
BACKUP_KEEP_DAYS=30
