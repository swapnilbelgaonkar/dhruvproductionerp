{
  "name": "@dhruv/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsup src/server.ts src/worker.ts src/db/migrate.ts src/db/seed.ts --format esm --target node22 --clean --noExternal @dhruv/contracts",
    "start": "node dist/server.js",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@dhruv/contracts": "workspace:*",
    "@node-rs/argon2": "2.0.2",
    "cookie-parser": "1.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "nodemailer": "6.9.16",
    "otplib": "12.0.1",
    "pg": "8.13.1",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "qrcode": "1.5.4",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/node": "22.10.5",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "8.11.10",
    "@types/qrcode": "1.5.5",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
